# Banco de Dados MySQL
DATABASE_URL=mysql://usuario:senha@localhost:3306/nome_do_banco

# Chaves de Sessão e Autenticação
SESSION_SECRET=troque-por-uma-string-aleatoria-longa
# Obrigatório para assinar os tokens JWT do Auth.js (gerado via openssl rand -base64 32)
AUTH_SECRET=your_random_secret_here

# Credenciais do administrador do painel
ADMIN_EMAIL=admin@clickservico.com.br
ADMIN_PASSWORD=your_strong_password_here

# Configurações de E-mail (SMTP)
SMTP_HOST=smtp.exemplo.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=usuario@exemplo.com
SMTP_PASS=sua-senha-smtp
SMTP_FROM="ClickServiço <no-reply@exemplo.com>"

# URL Base da Aplicação
NEXT_PUBLIC_APP_URL=http://localhost:3000

