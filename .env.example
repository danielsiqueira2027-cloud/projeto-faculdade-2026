# =============================================================================
# ClickServico — Variáveis de Ambiente (.env.example)
# Copie este arquivo para `.env` ou `.env.local` e preencha os valores.
# =============================================================================

# Banco de Dados (PostgreSQL / Supabase)
DATABASE_URL=

# Supabase Credentials (API / Auth / Storage)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# URL Base da Aplicação (URL oficial do deploy)
NEXT_PUBLIC_APP_URL=

# Sessão e Autenticação
SESSION_SECRET=
AUTH_SECRET=

# Credenciais Iniciais de Administrador
ADMIN_EMAIL=
# Hash bcrypt gerado com cost 12:
# node -e "const b=require('bcryptjs'); b.hash('SuaSenhaAdmin', 12).then(console.log)"
ADMIN_PASSWORD_HASH=

# Criptografia e Blindagem de Dados Sensíveis (LGPD)
# Chave de 32 bytes (64 caracteres hex) para cifragem AES-256-GCM do CPF:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CPF_ENCRYPTION_KEY=

# Pepper de 32 bytes (64 caracteres hex) para HMAC-SHA256 do CPF (busca de duplicidade):
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CPF_HASH_PEPPER=

